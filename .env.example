# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" and paste your free keys.
#  You can put MULTIPLE keys per provider, comma-separated.
#  Each key is treated as its own slot in the failover loop,
#  so 3 Groq keys = 3x the free quota before it gives up.
#  Leave any line blank to skip that provider.
#  NEVER put real keys in THIS file — put them in .env (gitignored).
# ─────────────────────────────────────────────────────────────

# ---- TRANSCRIPTION (reel audio -> text) ----
# Groq: free, very fast Whisper. https://console.groq.com/keys
GROQ_API_KEYS=
# Deepgram: $200 free credit. https://console.deepgram.com/
DEEPGRAM_API_KEYS=
# AssemblyAI: free tier. https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEYS=
# Set to 1 to enable local faster-whisper fallback (no key, no quota, needs `pip install faster-whisper`)
ENABLE_LOCAL_WHISPER=0

# ---- LLM (claim extraction + verdict) ----
# Google Gemini: generous free tier. https://aistudio.google.com/apikey
GEMINI_API_KEYS=
# Groq LLM (llama-3.3-70b): free. Same key as above works.
GROQ_LLM_API_KEYS=
# OpenRouter: has free models. https://openrouter.ai/keys
OPENROUTER_API_KEYS=

# ---- WEB SEARCH (find evidence) ----
# Google Fact Check Tools API: FREE, searches PIB/BOOM/AltNews/AFP etc.
# https://console.cloud.google.com/  (enable "Fact Check Tools API")
GOOGLE_FACTCHECK_API_KEYS=
# Tavily: 1000 free/month. https://app.tavily.com/
TAVILY_API_KEYS=
# Brave Search: 2000 free/month. https://api-dashboard.search.brave.com/
BRAVE_API_KEYS=
# DuckDuckGo needs no key and is always the last-resort fallback (built in).

# ---- ADMIN ----
# Secret to view the private /stats dashboard. Without a matching ?token=,
# /stats and its APIs return 404. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
STATS_TOKEN=
